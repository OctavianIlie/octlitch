#!/bin/bash
set -euo pipefail

MARKER="$HOME/.config/octlitch-first-login-done"

if [ -f "$MARKER" ]; then
    exit 0
fi

mkdir -p "$HOME/.config"

plasma-apply-lookandfeel --apply org.octlitch.valley.desktop
plasma-apply-wallpaperimage /usr/share/wallpapers/Octlitch/artificial-valley.jpg

KACTIVITY="$HOME/.config/kactivitymanagerd-statsrc"

if [[ -f "$KACTIVITY" ]]; then
    sed -i \
        's/,org\.kde\.discover\.desktop//g; s/org\.kde\.discover\.desktop,//g; s/org\.kde\.discover\.desktop//g' \
        "$KACTIVITY"
fi

touch "$MARKER"
