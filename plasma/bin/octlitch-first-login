#!/bin/bash

MARKER="$HOME/.config/octlitch-first-login-done"

if [ -f "$MARKER" ]; then
    exit 0
fi

mkdir -p "$HOME/.config"

plasma-apply-lookandfeel --apply org.octlitch.valley.desktop

plasma-apply-wallpaperimage \
  /usr/share/wallpapers/OctlitchValley/contents/images/artificial-valley.jpg

touch "$MARKER"
