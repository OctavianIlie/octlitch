{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "/usr/share/octlitch/ascii.txt",
        "padding": {
            "right": 3
        }
    },

    "display": {
        "separator": ": "
    },

    "modules": [
        "title",
        "separator",

        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "display",
            "key": "Display"
        },
        {
            "type": "de",
            "key": "Desktop Environment"
        },
        {
            "type": "wm",
            "key": "Window Manager"
        },
        {
            "type": "wmtheme",
            "key": "WM Theme"
        },
        {
            "type": "theme",
            "key": "Theme"
        },
        {
            "type": "icons",
            "key": "Icons"
        },
        {
            "type": "font",
            "key": "Font"
        },
        {
            "type": "cursor",
            "key": "Cursor"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "swap",
            "key": "Swap"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/"
        },
        {
            "type": "localip",
            "key": "Local IP",
            "format": "{ipv4} ({ifname})"
        },
        {
            "type": "locale",
            "key": "Locale"
        },

        "break",
        "colors"
    ]
}
